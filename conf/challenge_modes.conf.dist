[worldserver]

########################################
# Challenge Mods Config (Tofu Worldview fork)
########################################
#    ChallengeModes.Enable
#        Description: Enable challenge modes.
#            If set to 0, all challenges will be disabled, and the challenge mode selection object will not be present in starting areas.
#            Requires EnablePlayerSettings = 1 in worldserver.conf (challenges are stored as player settings).
#        Default:     0 - Disabled
#                     1 - Enabled
#

ChallengeModes.Enable = 1

#    ChallengeModes.GroupRestriction
#        Description: Characters with at least one active challenge other than Progression can only group with other such characters.
#            Applies to invites, invite accepts, and every other way a character joins a group (playerbots commands, random bot invites).
#            Battleground and Wintergrasp groups are exempt. The Dungeon Finder is only open to a full party of five such characters.
#        Default:     1 - Enabled
#                     0 - Disabled
#

ChallengeModes.GroupRestriction = 1

#    ChallengeModes.EnforceEquipment
#        Description: Self Crafted and Green Quality safety net. Items equipped without the normal equip check (playerbots autogear, bot factory gear) are moved to the bags, or mailed when the bags are full.
#            The same check runs at login and when one of these challenges is taken.
#        Default:     1 - Enabled
#                     0 - Disabled
#

ChallengeModes.EnforceEquipment = 1

#    ChallengeModes.BlockDeathKnightSkip
#        Description: Characters on a challenge other than Progression cannot skip the Death Knight starting zone at the Lich King (mod-skip-dk-starting-area, including the Tofu fork's cloak and weapon menus). GM accounts are exempt.
#            Also set Skip.Deathknight.Starter.Enable = 0 in skip_dk_module.conf, or every non-GM Death Knight is skipped to level 58 at first login, before it can reach the shrine.
#        Default:     1 - Enabled
#                     0 - Disabled
#

ChallengeModes.BlockDeathKnightSkip = 1

#    ChallengeModes.TcgCodes.Enable
#        Description: Issue mod-tcg-vendors redemption codes as level rewards (<Challenge>.TcgCodeRewards).
#            Each code is written to the codes table and put in the body of the challenge's reward mail, in the same database transaction.
#            Codes go to player-made characters only (altbots included), never to random bots or addclass bots.
#            Needs mod-tcg-vendors in the build: at startup the table below must exist in the characters database, or codes stay off until the next start (logged as an error).
#            Every issued code is logged to Server.log with the character, account, challenge, and level.
#        Default:     0 - Disabled
#                     1 - Enabled
#

ChallengeModes.TcgCodes.Enable = 1

#    ChallengeModes.TcgCodes.Table
#        Description: Name of mod-tcg-vendors' codes table in the characters database. Letters, digits, and underscores only. Read at startup only.
#        Default:     "account_tcg_codes"
#

ChallengeModes.TcgCodes.Table = "account_tcg_codes"

#    ChallengeModes.RewardMail.Sender
#        Description: Creature entry the reward mails come from, on normal stationery, the same way the core sends achievement mail (Rhonin's level 80 letter comes from 16128). Gold, ItemRewards items, and redemption codes of one challenge level arrive together in one mail (a second mail only when the items need more than 12 slots).
#            0 sends the mail from the player on GM stationery and keeps item rewards in a separate Postmaster mail (the old behavior). An entry that does not exist is logged at startup and treated as 0.
#        Default:     16128 - Rhonin
#

ChallengeModes.RewardMail.Sender = 16128

#    ChallengeModes.Master.AchievementId
#    ChallengeModes.Master.TcgCodeRewards
#    ChallengeModes.Master.GoldReward
#    ChallengeModes.Master.RewardMail.Subject
#    ChallengeModes.Master.RewardMail.Body
#        Description: When a player-made character completes the achievement AchievementId (for example a meta achievement over the challenge achievements), it gets one reward mail from RewardMail.Sender with GoldReward copper attached and one redemption code per key in TcgCodeRewards (space or comma separated); it is sent when it has gold or at least one code. Sent once per character (flag in character_settings, source mod-tofu-challenge-rewards, index 0), never to random or addclass bots. Codes need ChallengeModes.TcgCodes.Enable = 1.
#            If another module copies the achievement to alts (for example mod-account-bound), each player-made alt that receives it also gets the mail once.
#            Body placeholder: {CODES}, as in <Challenge>.RewardMail.Body. Write \n for a line break.
#        Default:     AchievementId 0 (off), TcgCodeRewards "", GoldReward 0, Subject "Master of Challenges", Body "Congratulations on mastering every challenge.\n\n{CODES}"
#

ChallengeModes.Master.AchievementId = 60005
ChallengeModes.Master.TcgCodeRewards = ""
ChallengeModes.Master.GoldReward = 100000000
ChallengeModes.Master.RewardMail.Subject = "Master of Challenges"
ChallengeModes.Master.RewardMail.Body = "Champion,\n\nHardcore, Self Crafted, Green Quality, One Rate, and Quest Only: every challenge this world could set before you, and you met them all on a single life. No one in the memory of Dalaran has done the same.\n\nYou now stand among the leaders of Azeroth, and from this day all will know you as such. The Kirin Tor have set aside 10,000 gold in your honor. Spend it as a leader would.\n\nRhonin"

#
#    The following challenge modes are available:
#        Hardcore - Players who die are permanently dead. Nobody can resurrect them, and they cannot cast the spells in Hardcore.BlockedSpells.
#        SelfCrafted - Players can only equip items they crafted. Exempt: items needed for a quest, starting weapons and gear, tools (fishing poles and profession tools), shirts, tabards, bags, and SelfCrafted.ExemptItems.
#        ItemQualityLevel - "Green Quality" in game. Players can only equip items up to ItemQualityLevel.MaxQuality.
#        OneRate - mod-individual-xp sets the personal .xp rate to x1 and locks it while this is active.
#        QuestXpOnly - "Quest Only" in game. Kills give no XP (the pet keeps its kill XP). mod-individual-xp sets the personal rate to x2 (x1 when OneRate is also active) and locks it, which doubles all other XP. QuestXpOnly.XPMultiplier is an extra factor on non-kill XP (1 = none; 2 would make it x4).
#        Progression - Turns on mod-individual-progression for the character. Never ends at a level (DisableLevel 0); it ends when the final raid tier is cleared.
#        Retired on Tofu Worldview (Enable = 0, kept so existing settings still load):
#        SemiHardcore - Players who die lose all worn equipment and carried gold.
#        SlowXpGain - Players receive 0.5x the normal amount of XP.
#        VerySlowXpGain - Players receive 0.25x the normal amount of XP.
#        IronMan - Enforces the Iron Man ruleset (https://wowchallenges.com/challangeinfo/iron-man/)
#
#    The options for each mode follow the same format. "<Challenge>" is replaced with the name of the challenge, such as Hardcore. The following options are possible:
#    <Challenge>.Enable = 1
#        If set to 0, this challenge option will not be selectable at the challenge modes object, and characters that already have it are treated as not having it.
#    <Challenge>.XPMultiplier = 1
#        Multiplies XP the player gains if this challenge is enabled.
#    <Challenge>.DisableLevel = 80
#        When the player reaches this level, the challenge ends: its restrictions are removed and it is recorded as completed. Rewards for that level are given first.
#        To never end a challenge at a level, set to 0.
#    <Challenge>.TitleRewards = ""
#        Titles granted on reaching a level. The IDs are from CharTitles.dbc. Format: "level titleId", entries separated by commas. Several titles per level are allowed.
#        Example: <Challenge>.TitleRewards = "60 143, 80 145"
#    <Challenge>.TalentRewards = ""
#        Bonus talent points granted on reaching a level. Format: "level points", entries separated by commas.
#        Example: <Challenge>.TalentRewards = "80 5"
#    <Challenge>.ItemRewards = ""
#        Items mailed on reaching a level. Format: "level itemId [count]", entries separated by commas. Several items per level are allowed. Without a count, <Challenge>.ItemRewardAmount is used.
#        Example: <Challenge>.ItemRewards = "80 701001 1, 80 54811"
#    <Challenge>.ItemRewardAmount = 1
#        Default count for ItemRewards entries that do not give one.
#    <Challenge>.GoldRewards = ""
#        Money mailed on reaching a level, in copper (1 gold = 10000 copper). Format: "level copper", entries separated by commas.
#        Example: <Challenge>.GoldRewards = "80 150000000"
#    <Challenge>.AchievementReward = ""
#        Achievements granted on reaching a level. Format: "level achievementId", entries separated by commas.
#        Example: <Challenge>.AchievementReward = "80 1234"
#
#    <Challenge>.TcgCodeRewards = ""
#        mod-tcg-vendors redemption codes issued on reaching a level, one code per entry. Needs ChallengeModes.TcgCodes.Enable = 1. Format: "level REWARD_GROUP", entries separated by commas. Several codes per level are allowed.
#        REWARD_GROUP is a key from mod-tcg-vendors (list them with: python tools/generate_codes.py --list-groups). A key unknown to this module is logged as a warning at startup but still issued.
#        Example: <Challenge>.TcgCodeRewards = "80 TCG_SPECTRAL_TIGER"
#    <Challenge>.RewardMail.Subject = "{MODE} reward"
#    <Challenge>.RewardMail.Body = "Congratulations on reaching level {LEVEL} on the {MODE} challenge.\n\n{CODES}"
#        The mail sent for a level that has GoldRewards, ItemRewards, or TcgCodeRewards: one mail per challenge and level from ChallengeModes.RewardMail.Sender, with the gold and items attached and the codes in the body.
#        Placeholders: {MODE} (challenge name), {LEVEL}, and {CODES} (body only: for each code the item name, the code, and the TCG vendor NPCs that list the item; empty when the level has no codes).
#        Write \n for a line break. Put {CODES} on its own line (\n\n{CODES}\n\n); it starts with "Your redemption code:". When the level has no code, {CODES} and the blank line before it are removed. If the body has no {CODES}, the codes are added at the end after a blank line, so a code is never left out.
#
#    The shrine lists each challenge's rewards from these keys (titles, talent points, gold, items, redemption codes, and achievements, by level) on the second confirmation, so a conf change shows there after a restart or config reload.
#    Levels are rewarded even when a level is skipped (for example with a Level-Up Token or a GM command).
#    Custom titles and custom items need their own DBC rows, database rows, and client patch before their IDs are put here.
#

Hardcore.Enable = 1
Hardcore.TitleRewards = ""
Hardcore.XPMultiplier = 1
Hardcore.TalentRewards = "80 7"
Hardcore.ItemRewards = "80 54218 5, 80 50301 7"
Hardcore.ItemRewardAmount = 1
Hardcore.GoldRewards = ""
Hardcore.DisableLevel = 80
Hardcore.AchievementReward = "80 60000"
Hardcore.TcgCodeRewards = "80 PROMO_LIL_PHYLACTERY"
Hardcore.RewardMail.Subject = "The Hardcore challenge"
Hardcore.RewardMail.Body = "Champion,\n\nWord has reached the Violet Citadel that you climbed from your first steps to the height of your power without falling once. Not a single death. I have known archmages who could not claim as much.\n\nThe Kirin Tor have recorded your deed, and from this day you may call yourself the Unfallen. The strength you earned is already yours. The rest of our thanks is enclosed: gift boxes, pet boxes, and a small companion who knows a thing or two about cheating death.\n\n{CODES}\n\nStay unfallen.\n\nRhonin"

#    Hardcore.BlockedSpells
#        Description: Spell IDs a Hardcore character cannot cast because they kill the caster. Space or comma separated.
#        Default:     "19752" - Divine Intervention
#

Hardcore.BlockedSpells = "19752"

SelfCrafted.Enable = 1
SelfCrafted.TitleRewards = ""
SelfCrafted.XPMultiplier = 1
SelfCrafted.TalentRewards = "80 5"
SelfCrafted.ItemRewards = "80 54218 3, 80 50301 5"
SelfCrafted.ItemRewardAmount = 1
SelfCrafted.GoldRewards = ""
SelfCrafted.DisableLevel = 80
SelfCrafted.AchievementReward = "80 60001"
SelfCrafted.TcgCodeRewards = "80 PROMO_LIL_XT"
SelfCrafted.RewardMail.Subject = "The Self Crafted challenge"
SelfCrafted.RewardMail.Body = "Champion,\n\nEvery blade, buckle, and stitch you wore on the road to your full strength was made by your own hands. The artisans of Dalaran speak of little else.\n\nFrom this day you are the Self-Founded. Enclosed are gift boxes, pet boxes, and a little mechanical friend to keep your workshop company. I am told he only breaks things occasionally.\n\n{CODES}\n\nRhonin"

#    SelfCrafted.ExemptItems
#        Description: Extra item IDs Self Crafted characters may equip, on top of the built-in exemptions. Space or comma separated.
#        Default:     ""
#

SelfCrafted.ExemptItems = ""

ItemQualityLevel.Enable = 1
ItemQualityLevel.TitleRewards = ""
ItemQualityLevel.XPMultiplier = 1
ItemQualityLevel.TalentRewards = "80 5"
ItemQualityLevel.ItemRewards = "80 54218 3, 80 50301 5"
ItemQualityLevel.ItemRewardAmount = 1
ItemQualityLevel.GoldRewards = ""
ItemQualityLevel.DisableLevel = 80
ItemQualityLevel.AchievementReward = "80 60002"
ItemQualityLevel.TcgCodeRewards = "80 TCG_SPECTRAL_TIGER_CUB"
ItemQualityLevel.RewardMail.Subject = "The Green Quality challenge"
ItemQualityLevel.RewardMail.Body = "Champion,\n\nYou turned your back on the gleam of rare and epic treasures and reached your full strength in humble green. Many claim gear makes the hero. You have proven them wrong.\n\nFrom this day you are the Iron-Priced. Enclosed are gift boxes, pet boxes, and a spectral cub. A rare thing, and you have more than earned it.\n\n{CODES}\n\nRhonin"

#    ItemQualityLevel.MaxQuality
#        Description: Highest item quality Green Quality characters may equip. Bags and quivers are exempt.
#        Default:     2 - Uncommon (green)
#                     1 - Common (white)
#

ItemQualityLevel.MaxQuality = 2

OneRate.Enable = 1
OneRate.TitleRewards = ""
OneRate.XPMultiplier = 1
OneRate.TalentRewards = "80 2"
OneRate.ItemRewards = "80 54218 1, 80 50301 3"
OneRate.ItemRewardAmount = 1
OneRate.GoldRewards = ""
OneRate.DisableLevel = 80
OneRate.AchievementReward = "80 60003"
OneRate.TcgCodeRewards = "80 PROMO_WARBOT_KEY"
OneRate.RewardMail.Subject = "The One Rate challenge"
OneRate.RewardMail.Body = "Champion,\n\nNo shortcuts and no haste. You walked the long road at the world's own pace, and you walked it to the end. Patience is the rarest virtue in Azeroth, and you have it in abundance.\n\nEnclosed are gift boxes, pet boxes, and a small warbot to keep you company on whatever road comes next.\n\n{CODES}\n\nRhonin"

QuestXpOnly.Enable = 1
QuestXpOnly.TitleRewards = ""
QuestXpOnly.XPMultiplier = 1
QuestXpOnly.TalentRewards = "80 2"
QuestXpOnly.ItemRewards = "80 54218 1, 80 50301 3"
QuestXpOnly.ItemRewardAmount = 1
QuestXpOnly.GoldRewards = ""
QuestXpOnly.DisableLevel = 80
QuestXpOnly.AchievementReward = "80 60004"
QuestXpOnly.TcgCodeRewards = "80 PROMO_GRYPHON_HATCHLING, 80 PROMO_WIND_RIDER_CUB"
QuestXpOnly.RewardMail.Subject = "The Quest Only challenge"
QuestXpOnly.RewardMail.Body = "Champion,\n\nYou earned your power not by the sword but by the road: every errand run, every letter carried, and every soul helped along the way. Half of Azeroth owes you a favor.\n\nFrom this day you are the Globetrotter. Enclosed are gift boxes, pet boxes, and a pair of hatchlings, one gryphon and one wind rider, so that both banners may remember your kindness.\n\n{CODES}\n\nRhonin"

Progression.Enable = 1
Progression.TitleRewards = ""
Progression.XPMultiplier = 1
Progression.TalentRewards = ""
Progression.ItemRewards = "80 701001 1, 80 54218 5, 80 50301 5"
Progression.ItemRewardAmount = 1
Progression.GoldRewards = "80 50000000"
Progression.DisableLevel = 0
Progression.AchievementReward = ""
Progression.TcgCodeRewards = ""
Progression.RewardMail.Subject = "The Progression challenge"
Progression.RewardMail.Body = "Champion,\n\nYou have watched Azeroth grow around you, age by age, from the old kingdoms to the frozen north. You reached the height of your power while the world itself was still unfolding.\n\nThe Kirin Tor send 5,000 gold, five gift boxes, five pet boxes, and a level-up token. The token is of no use to you now, for you have nothing left to grow into. In the hands of another hero on a similar path, though, it could be a powerful thing indeed.\n\nRhonin"

